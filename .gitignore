__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.env
*.tfstate
*.tfstate.*
.terraform/
.DS_Store
data/
*.parquet
*.gguf
# …but a use-case's committed FIXTURES are not a dataset. `data/` is here for
# downloaded corpora, which must never be committed; `store-assistant` ships
# four small synthetic JSON files inside its package so its suite runs offline.
# They were silently excluded by the rule above and the tests passed locally
# while failing on a clean checkout — the difference being files that existed
# on one machine and in no commit.
!projects/*/src/*/data/
!projects/*/src/*/data/**

# MCP config carries credentials; only the example is committed.
.codex/mcp.json
.mcp.json
coverage.xml

# Terraform provider plugins and lock metadata from `init -backend=false`,
# which the validation gate runs. The lock FILE is committed; the .terraform
# directory it populates is a local cache.
platform/terraform/**/.terraform/
